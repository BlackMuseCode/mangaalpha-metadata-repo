{
  "schema": "mangaalpha-repo-v1",
  "version": "2026.11.25.1",
  "name": "MangaAlpha 社区元数据仓库",
  "description": "面向 MangaAlpha v3.2+ 的声明式元数据市场清单：包含 Bangumi 离线源、社区离线图库索引、中文标签翻译词典与社区脱敏标题映射包。",
  "homepage": "https://github.com/BlackMuseCode/mangaalpha-metadata-repo",
  "sources": [
    {
      "id": "bgm-zh-cn",
      "kind": "bangumi_archive",
      "schema": "bangumi_archive_v1",
      "name": "Bangumi 中文简介增强镜像",
      "description": "与官方 100% 同构，外文非 NSFW 条目简介已译为简体中文（每周自动同步）。",
      "manifestUrl": "https://raw.githubusercontent.com/xJogger/bangumi-archive-zh/main/aux/latest.json",
      "homepage": "https://github.com/xJogger/bangumi-archive-zh",
      "default": true,
      "autoUpdateDefault": "weekly"
    },
    {
      "id": "bgm-official",
      "kind": "bangumi_archive",
      "schema": "bangumi_archive_v1",
      "name": "Bangumi 官方原版归档",
      "description": "bangumi/Archive 官方原版周更离线快照。",
      "manifestUrl": "https://raw.githubusercontent.com/bangumi/Archive/master/aux/latest.json",
      "homepage": "https://github.com/bangumi/Archive",
      "autoUpdateDefault": "weekly"
    },
    {
      "id": "gallery-nightly",
      "kind": "offline_sqlite",
      "schema": "gallery_v1",
      "name": "社区离线图库索引（Nightly）",
      "description": "每日自动同步的社区全量离线图库 SQLite 索引（压缩包约 1.0 GB，解压及索引约 4–6 GB；默认手动更新，支持关联中文标签翻译词典）。",
      "downloadUrl": "https://github.com/URenko/e-hentai-db/releases/download/nightly/e-hentai.db.zstd",
      "releaseApiUrl": "https://api.github.com/repos/URenko/e-hentai-db/releases/tags/nightly",
      "assetName": "e-hentai.db.zstd",
      "compression": "zstd",
      "sizeHintBytes": 1077480366,
      "defaultTagDictId": "tag-dict-zh-cn",
      "nsfwRule": "non_h_safe",
      "autoUpdateDefault": "manual",
      "homepage": "https://github.com/URenko/e-hentai-db"
    },
    {
      "id": "tag-dict-zh-cn",
      "kind": "tag_dictionary",
      "schema": "tag_translation_text_v1",
      "name": "社区中文标签翻译词典",
      "description": "每日同步的社区中文标签词典（db.text.json.gz，约 1.3 MB），用于将离线图库英文标签译为简体中文或双语。",
      "downloadUrl": "https://github.com/EhTagTranslation/Database/releases/latest/download/db.text.json.gz",
      "releaseApiUrl": "https://api.github.com/repos/EhTagTranslation/Database/releases/latest",
      "assetName": "db.text.json.gz",
      "compression": "gzip",
      "sizeHintBytes": 1320000,
      "autoUpdateDefault": "weekly",
      "homepage": "https://github.com/EhTagTranslation/Database"
    },
    {
      "id": "community-mappings",
      "kind": "mapping_pack",
      "schema": "mangaalpha_mapping_v1",
      "name": "社区脱敏标题映射包",
      "description": "社区共建的疑难目录名脱敏精确映射（仅在离线数据库未命中时兜底），欢迎通过 PR 补充分享。",
      "manifestUrl": "https://raw.githubusercontent.com/BlackMuseCode/mangaalpha-metadata-repo/main/mappings/index.json",
      "downloadUrl": "https://raw.githubusercontent.com/BlackMuseCode/mangaalpha-metadata-repo/main/mappings/community-bangumi.ndjson",
      "compression": "none",
      "autoUpdateDefault": "weekly",
      "homepage": "https://github.com/BlackMuseCode/mangaalpha-metadata-repo",
      "contributeUrl": "https://github.com/BlackMuseCode/mangaalpha-metadata-repo/pulls"
    }
  ]
}
